{
  "name": "secondsource",
  "version": "0.1.0",
  "private": true,
  "description": "A Coworker that checks a market headline against signed primary sources before an agent trades on it",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "tsc": "tsc",
    "wallet:new": "node src/scripts/new-wallet.ts",
    "wallet:balance": "node --env-file-if-exists=.env src/scripts/balance.ts",
    "probe": "node --env-file-if-exists=.env src/scripts/probe.ts",
    "mint": "node --env-file-if-exists=.env src/scripts/mint.ts",
    "check": "node --env-file-if-exists=.env src/cli.ts",
    "site:data": "node src/scripts/site-data.ts",
    "worker": "node --env-file-if-exists=.env src/coworker/worker.ts",
    "masumi": "node --env-file-if-exists=.env src/coworker/register.ts",
    "vault:signer": "node src/scripts/new-wallet.ts COWORKER_SIGNER_KEY",
    "vault:fixtures": "node src/scripts/vault-fixtures.ts",
    "vault:deploy": "node --env-file-if-exists=.env src/vault/deploy.ts",
    "vault:trade": "node --env-file-if-exists=.env src/vault/trade.ts",
    "contracts:test": "cd contracts && forge test"
  },
  "dependencies": {
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "~6.0.3"
  }
}
