{
  "name": "secondsource",
  "version": "0.1.0",
  "private": true,
  "description": "A Coworker that checks a market headline against signed primary sources before an agent trades on it",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "tsc": "tsc",
    "wallet:new": "node src/scripts/new-wallet.ts",
    "wallet:balance": "node --env-file-if-exists=.env src/scripts/balance.ts",
    "probe": "node --env-file-if-exists=.env src/scripts/probe.ts",
    "mint": "node --env-file-if-exists=.env src/scripts/mint.ts",
    "check": "node --env-file-if-exists=.env src/cli.ts",
    "site:data": "node --env-file-if-exists=.env src/scripts/site-data.ts",
    "worker": "node --env-file-if-exists=.env src/coworker/worker.ts",
    "masumi": "node --env-file-if-exists=.env src/coworker/register.ts",
    "vault:signer": "node src/scripts/new-wallet.ts COWORKER_SIGNER_KEY",
    "vault:fixtures": "node src/scripts/vault-fixtures.ts",
    "vault:deploy": "node --env-file-if-exists=.env src/vault/deploy.ts && node src/scripts/vault-export.ts",
    "contracts:test": "cd contracts && forge test",
    "agent": "node --env-file-if-exists=.env src/scripts/agent-demo.ts",
    "faucet": "node --env-file-if-exists=.env src/scripts/faucet.ts",
    "x402:wallet": "node --env-file-if-exists=.env src/scripts/cardano-buyer-wallet.ts",
    "x402:buy": "node --env-file-if-exists=.env src/scripts/x402-buy.ts",
    "api:local": "node --env-file-if-exists=.env src/scripts/local-api.ts",
    "vault:act": "node --env-file-if-exists=.env src/vault/trade.ts",
    "tamper-test": "node --env-file-if-exists=.env src/scripts/tamper-test.ts",
    "contracts:build": "cd contracts && forge build",
    "vault:export": "node src/scripts/vault-export.ts",
    "vault:verify": "node --env-file-if-exists=.env src/scripts/vault-verify.ts"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "^0.8.0",
    "@x402/cardano": "2.29.0",
    "@x402/core": "2.29.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.60.0",
    "@types/node": "^24.19.1",
    "@x402/express": "2.29.0",
    "typescript": "~6.0.3"
  }
}
