# Base Sepolia account that pays AirnodeHub over x402 and sends vault transactions: pnpm wallet:new
PAYER_PRIVATE_KEY=
# Key SecondSource signs vault verdicts with: pnpm vault:signer
COWORKER_SIGNER_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Coinbase CDP faucet for Base Sepolia gas (portal.cdp.coinbase.com/api-keys/secret): pnpm faucet
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Cardano preprod (blockfrost.io), used by the x402 buyer and the Masumi Payment Service
BLOCKFROST_API_KEY_PREPROD=
# Demo buyer agent on Cardano preprod: pnpm x402:wallet --fund
BUYER_CARDANO_MNEMONIC=
# OpenRouter models through the Airnode, tried in order (optional)
JUDGE_MODELS=
# Sokosumi coworker and Masumi Payment Service (docs/setup-human-steps.md)
SOKOSUMI_API_KEY=
COWORKER_ID=
PAID_TASKS_ENABLED=false
MPS_URL=http://127.0.0.1:3001
MPS_ADMIN_KEY=
MPS_RUNTIME_TOKEN=
MPS_WALLET_ID=
MPS_SOURCE_ID=
# Unlocks the live-check tab on the website (optional)
DEMO_KEY=
