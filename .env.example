# Base Sepolia account that pays AirnodeHub calls in aUSD over x402. Create one with `pnpm wallet:new`.
PAYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Coinbase CDP faucet for Base Sepolia gas (portal.cdp.coinbase.com/api-keys/secret). `pnpm faucet`
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
